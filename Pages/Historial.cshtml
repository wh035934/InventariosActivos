@page
@model HistorialModel
@{
    ViewData["Title"] = "Historial";
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2>Total productos</h2>
                <p class="fs-3 mb-0">@Model.Productos.Count</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2>Total entregas</h2>
                <p class="fs-3 mb-0">@Model.Entregas.Count</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Productos registrados</div>
    <div class="card-body">
        <ul class="list-group list-group-flush">
            @foreach (var p in Model.Productos)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@p.Nombre (@p.Modelo)</span>
                    <span class="text-muted">@p.FechaRegistro</span>
                </li>
            }
        </ul>
    </div>
</div>

<div class="card">
    <div class="card-header">Entregas registradas</div>
    <div class="card-body">
        <ul class="list-group list-group-flush">
            @foreach (var e in Model.Entregas)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@e.Nombre</span>
                    <span class="text-muted">@e.Area - @e.Estado</span>
                </li>
            }
        </ul>
    </div>
</div>
