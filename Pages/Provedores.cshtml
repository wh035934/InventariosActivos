@page
@model ProvedoresModel
@{
    ViewData["Title"] = "Proveedores";
    var editando = Model.Input.Id != 0;
}

<div class="card mb-4">
    <div class="card-header">@(editando ? "Editar proveedor" : "Agregar proveedor")</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Guardar">
            <input type="hidden" asp-for="Input.Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre proveedor</label>
                    <input class="form-control" asp-for="Input.Nombre" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Contacto</label>
                    <input class="form-control" asp-for="Input.Contacto" required />
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">Teléfono</label>
                    <input class="form-control" asp-for="Input.Telefono" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Correo</label>
                    <input class="form-control" asp-for="Input.Correo" type="email" required />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(editando ? "Actualizar Proveedor" : "Agregar Proveedor")</button>
                @if (editando)
                {
                    <a class="btn btn-secondary" asp-page="/Provedores">Cancelar</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Contacto</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Proveedores)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Nombre</td>
                            <td>@p.Contacto</td>
                            <td>@p.Telefono</td>
                            <td>@p.Correo</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-link btn-sm" asp-page="/Provedores" asp-route-editId="@p.Id">Edit</a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@p.Id" onsubmit="return confirm('¿Eliminar proveedor?');">
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Eliminar">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
