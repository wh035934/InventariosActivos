@page
@model GestionModel
@{
    ViewData["Title"] = "Gestion";
    var editando = Model.Input.Id != 0;
}

<div class="card mb-4">
    <div class="card-header">@(editando ? "Editar producto" : "Agregar producto")</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Guardar">
            <input type="hidden" asp-for="Input.Id" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" asp-for="Input.Nombre" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Modelo</label>
                    <input class="form-control" asp-for="Input.Modelo" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Categoría</label>
                    <select class="form-select" asp-for="Input.Categoria" required>
                        <option value="computadoras">Computadoras</option>
                        <option value="monitores">Monitores</option>
                        <option value="celulares">Celulares</option>
                        <option value="audio">Audio</option>
                        <option value="cables-y-adaptadores">Cables y Adaptadores</option>
                        <option value="accesorios">Accesorios</option>
                        <option value="componentes">Componentes</option>
                        <option value="otros">Otros</option>
                    </select>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label">Ubicación</label>
                    <input class="form-control" asp-for="Input.Ubicacion" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cantidad</label>
                    <input class="form-control" asp-for="Input.Cantidad" type="number" min="0" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select class="form-select" asp-for="Input.Estado" required>
                        <option value="disponible">Disponible</option>
                        <option value="danado">Dañado</option>
                        <option value="en reparacion">En reparación</option>
                    </select>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label class="form-label">Fecha de registro</label>
                    <input class="form-control" asp-for="Input.FechaRegistro" type="date" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Precio</label>
                    <input class="form-control" asp-for="Input.Precio" type="number" min="0" step="0.01" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Descripción</label>
                    <textarea class="form-control" asp-for="Input.Descripcion" rows="1" required></textarea>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(editando ? "Actualizar Producto" : "Agregar Producto")</button>
                @if (editando)
                {
                    <a class="btn btn-secondary" asp-page="/Gestion">Cancelar</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Modelo</th>
                        <th>Categoría</th>
                        <th>Ubicación</th>
                        <th>Cantidad</th>
                        <th>Estado</th>
                        <th>Fecha de registro</th>
                        <th>Precio</th>
                        <th>Descripción</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Productos)
                    {
                        var badge = p.Estado == "danado" ? "bg-danger" : p.Estado == "en reparacion" ? "bg-warning text-dark" : "bg-success";
                        <tr>
                            <td>@p.Id</td>
                            <td><a asp-page="/Gestion" asp-route-editId="@p.Id">@p.Nombre</a></td>
                            <td>@p.Modelo</td>
                            <td>@p.Categoria</td>
                            <td>@p.Ubicacion</td>
                            <td>@p.Cantidad</td>
                            <td><span class="badge @badge">@p.Estado.ToUpper()</span></td>
                            <td>@p.FechaRegistro</td>
                            <td>$@p.Precio.ToString("F2")</td>
                            <td>@p.Descripcion</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-link btn-sm" asp-page="/Gestion" asp-route-editId="@p.Id">Edit</a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@p.Id" onsubmit="return confirm('¿Eliminar producto?');">
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Eliminar">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
