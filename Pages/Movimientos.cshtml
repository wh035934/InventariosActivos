@page
@model MovimientoModel
@{
    ViewData["Title"] = "Movimientos";
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Acción</th>
                        <th>Entidad</th>
                        <th>ID</th>
                        <th>Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Movimientos)
                    {
                        var color = m.Accion == "creado" ? "bg-success"
                                  : m.Accion == "actualizado" ? "bg-warning text-dark"
                                  : "bg-danger";
                        <tr>
                            <td>@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @color">@m.Accion.ToUpper()</span></td>
                            <td>@m.Entidad</td>
                            <td>@m.EntidadId</td>
                            <td>@m.Detalle</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>