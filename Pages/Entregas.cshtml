@page
@model EntregasModel
@{
    ViewData["Title"] = "Entrega";
    var editando = Model.Input.Id != 0;
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
<div class="card mb-4">
    <div class="card-header">@(editando ? "Editar entrega" : "Agregar entrega")</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Guardar"  enctype="multipart/form-data">
            <input type="hidden" asp-for="Input.Id" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" asp-for="Input.Nombre" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Puesto</label>
                    <input class="form-control" asp-for="Input.Puesto" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Área</label>
                    <select class="form-select" asp-for="Input.Area" required>
                        <option value="sistemas">Sistemas</option>
                        <option value="marketing">Marketing</option>
                        <option value="administracion">Administracion</option>
                        <option value="pagos">Pagos</option>
                        <option value="compras">Compras</option>
                        <option value="ventas">Ventas</option>
                        <option value="Recursos Humanos">Recursos Humanos</option>
                    </select>
                </div>
            </div>
            @if (!editando)     
            {
                <hr />
                <div class="text-muted small mb-2">Productos que se entregarán (se descuentan del inventario):</div>
                <div id="detalle-productos">
                    @for (var i = 0; i < Model.Detalles.Count; i++)
                    {
                        <div class="row g-2 align-items-center mb-2 producto-row">
                            <div class="col-md-7">
                                <select class="form-select" asp-for="Detalles[i].ProductoId">
                                    <option value="0">— Selecciona producto —</option>
                                    @foreach (var p in Model.Productos)
                                    {
                                        <option value="@p.Id">@p.Nombre (disponibles: @p.Cantidad)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <input type="number" min="1" class="form-control" asp-for="Detalles[i].Cantidad"
                                       placeholder="Cantidad" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-danger quitar-producto">Quitar</button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" id="agregar-producto" class="btn btn-outline-primary btn-sm">Agregar otro producto</button>
            }
            else                  
            {
                 <hr />
                 <div class="text-muted small mb-2">
                     Productos asignados (no se pueden modificar):
                 </div>
                 @if (Model.Input.Detalles.Count == 0)
                 {
                     <div class="text-muted">Sin productos asignados.</div>
                 }
                 else
                 {
                     <table class="table table-sm align-middle mb-0">
                         <thead>
                             <tr>
                                 <th>Producto</th>
                                 <th>Cantidad</th>
                             </tr>
                         </thead>
                         <tbody>
                             @foreach (var d in Model.Input.Detalles)
                             {
                                 <tr>
                                     <td>@(d.Producto?.Nombre ?? "—")</td>
                                     <td>@d.Cantidad</td>
                                 </tr>
                             }
                         </tbody>
                     </table>
                 }
            }
            @if (editando)
            {
                <hr />
                <div class="text-muted small mb-2">La evidencia (foto y firma) se adjunta después de entregar.</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Foto de artículos</label>
                        <input type="file" class="form-control" asp-for="Foto" accept=".jpg,.jpeg,.png,.webp" />
                        @if (!string.IsNullOrEmpty(Model.FotoEdicionUrl))
                        {
                            <img src="@Model.FotoEdicionUrl" class="img-thumbnail mt-2" style="max-height:120px" />
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Firma / hoja escaneada</label>
                        <input type="file" class="form-control" asp-for="Firma" accept=".jpg,.jpeg,.png,.webp" />
                        @if (!string.IsNullOrEmpty(Model.FirmaEdicionUrl))
                        {
                            <img src="@Model.FirmaEdicionUrl" class="img-thumbnail mt-2" style="max-height:120px" />
                        }
                    </div>
                </div>

            }
            @if (!editando)
            {
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const contenedor = document.getElementById('detalle-productos');
                        const botonAgregar = document.getElementById('agregar-producto');

                        function renumerarFilas() {
                            contenedor.querySelectorAll('.producto-row').forEach(function (fila, indice) {
                                fila.querySelectorAll('[name]').forEach(function (campo) {
                                    campo.name = campo.name.replace(/Detalles\[\d+\]/, `Detalles[${indice}]`);
                                });
                                fila.querySelectorAll('[id]').forEach(function (campo) {
                                    campo.id = campo.id.replace(/Detalles_\d+__/, `Detalles_${indice}__`);
                                });
                            });
                        }

                        botonAgregar.addEventListener('click', function () {
                            const filas = contenedor.querySelectorAll('.producto-row');
                            const nuevaFila = filas[0].cloneNode(true);
                            nuevaFila.querySelector('select').value = '0';
                            nuevaFila.querySelector('input[type="number"]').value = '';
                            contenedor.appendChild(nuevaFila);
                            renumerarFilas();
                        });

                        contenedor.addEventListener('click', function (evento) {
                            if (evento.target.closest('.quitar-producto')) {
                                const filas = contenedor.querySelectorAll('.producto-row');
                                const fila = evento.target.closest('.producto-row');
                                if (filas.length === 1) {
                                    fila.querySelector('select').value = '0';
                                    fila.querySelector('input[type="number"]').value = '';
                                    return;
                                }
                                fila.remove();
                                renumerarFilas();
                            }
                        });
                    });
                </script>
            }
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(editando ? "Actualizar Entrega" : "Agregar Entrega")</button>
                @if (editando)
                {
                    <a class="btn btn-secondary" asp-page="/Entregas">Cancelar</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Puesto</th>
                        <th>Área</th>
                        <th>Fecha</th>
                        <th>Evidencia</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Entregas)
                    {
                        <tr>
                            <td>@e.Nombre</td>
                            <td>@e.Puesto</td>
                            <td>@e.Area</td>
                            <td>@e.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge @(e.Cerrada ? "bg-success" : "bg-secondary")">
                                    @(e.Cerrada ? "CERRADA" : "PENDIENTE")
                                </span>
                                @if (Model.FotosUrl.TryGetValue(e.Id, out var fotoUrl) && fotoUrl is not null)
                                {
                                    <img src="@fotoUrl" title="Foto" style="height:28px; border-radius:4px;" />
                                }
                                @if (Model.FirmasUrl.TryGetValue(e.Id, out var firmaUrl) && firmaUrl is not null)
                                {
                                    <img src="@firmaUrl" title="Firma" style="height:28px; border-radius:4px;" />
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-link btn-sm" asp-page="/Entregas" asp-page-handler="Pdf" asp-route-id="@e.Id">Descargar PDF</a>
                                    <a class="btn btn-link btn-sm" asp-page="/Entregas" asp-route-editId="@e.Id">Edit</a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@e.Id" onsubmit="return confirm('¿Eliminar entrega?');">
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Eliminar">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
