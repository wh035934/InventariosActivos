@page
@model EntregasModel
@{
    ViewData["Title"] = "Entrega";
    var editando = Model.Input.Id != 0;
}

<div class="card mb-4">
    <div class="card-header">@(editando ? "Editar entrega" : "Agregar entrega")</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Guardar">
            <input type="hidden" asp-for="Input.Id" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" asp-for="Input.Nombre" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Puesto</label>
                    <input class="form-control" asp-for="Input.Puesto" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Área</label>
                    <select class="form-select" asp-for="Input.Area" required>
                        <option value="sistemas">sistemas</option>
                        <option value="marketing">marketing</option>
                        <option value="administracion">administracion</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select class="form-select" asp-for="Input.Estado" required>
                        <option value="activa">Activa</option>
                        <option value="urgente">Urgente</option>
                        <option value="pausada">Pausada</option>
                        <option value="cerrada">Cerrada</option>
                    </select>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(editando ? "Actualizar Entrega" : "Agregar Entrega")</button>
                @if (editando)
                {
                    <a class="btn btn-secondary" asp-page="/Entregas">Cancelar</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Puesto</th>
                        <th>Área</th>
                        <th>Estado</th>
                        <th>Accion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Entregas)
                    {
                        var badge = e.Estado == "urgente" ? "bg-danger" : e.Estado.Length > 5 ? "bg-primary" : "bg-success";
                        <tr>
                            <td>@e.Nombre</td>
                            <td>@e.Puesto</td>
                            <td>@e.Area</td>
                            <td><span class="badge @badge">@e.Estado.ToUpper()</span></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-link btn-sm" asp-page="/Entregas" asp-route-editId="@e.Id">Edit</a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@e.Id" onsubmit="return confirm('¿Eliminar entrega?');">
                                        <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Eliminar">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
