@page
@model UsuarioModel
@{
    ViewData["Title"] = "Usuario";
}

@if (Model.Actual is not null)
{
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:64px;height:64px;font-size:28px;">
                    @Model.Actual.Nombre.FirstOrDefault()
                </div>
                <div>
                    <h2 class="mb-0">@Model.Actual.Nombre</h2>
                    <p class="mb-1 text-muted">@Model.Actual.Rol</p>
                    <span class="badge bg-success">En línea</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editarPerfilModal">Editar Perfil</button>
                <form method="post" asp-page-handler="Salir">
                    <button type="submit" class="btn btn-danger">Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center justify-content-between">
            <div>
                <h2 class="mb-0">No has iniciado sesión</h2>
                <p class="mb-0 text-muted">Inicia sesión para ver tu perfil</p>
            </div>
            <a class="btn btn-primary" asp-page="/Login">Iniciar sesión</a>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Gestión de Usuarios</span>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#crearUsuarioModal">Crear Usuario</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Fecha de Creación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Usuarios)
                    {
                        var rolBadge = u.Rol == "Administrador" ? "bg-primary" : "bg-success";
                        <tr>
                            <td>@u.Nombre</td>
                            <td>@u.Correo</td>
                            <td><span class="badge @rolBadge">@u.Rol</span></td>
                            <td>@u.Fecha</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Usuario" asp-route-ver="@u.Id">Ver</a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-key="@u.Id" onsubmit="return confirm('¿Eliminar usuario?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.Seleccionado is not null)
{
    <div class="card mt-4">
        <div class="card-header">Perfil del usuario</div>
        <div class="card-body text-center">
            <h2 class="mb-0">@Model.Seleccionado.Nombre</h2>
            <p class="text-muted">@Model.Seleccionado.Rol</p>
            <span class="badge bg-success mb-3">En línea</span>
            <dl class="row text-start">
                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Seleccionado.Nombre</dd>
                <dt class="col-sm-3">Correo</dt>
                <dd class="col-sm-9">@Model.Seleccionado.Correo</dd>
                <dt class="col-sm-3">Rol</dt>
                <dd class="col-sm-9">@Model.Seleccionado.Rol</dd>
                <dt class="col-sm-3">Fecha de Creación</dt>
                <dd class="col-sm-9">@Model.Seleccionado.Fecha</dd>
            </dl>
            <a class="btn btn-secondary" asp-page="/Usuario">Cerrar</a>
        </div>
    </div>
}

<div class="modal fade" id="crearUsuarioModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Crear">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" asp-for="Input.Nombre" placeholder="Nombre completo" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <input class="form-control" asp-for="Input.Correo" placeholder="correo@empresa.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Área</label>
                        <select class="form-select" asp-for="Input.Area" required>
                            <option value="Administrativa">Administrativa</option>
                            <option value="Sistemas">Sistemas</option>
                            <option value="Recursos Humanos">Recursos Humanos</option>
                            <option value="Marketing">Marketing</option>
                            <option value="Contabilidad">Contabilidad</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select class="form-select" asp-for="Input.Rol" required>
                            <option value="Administrador">Administrador</option>
                            <option value="Empleado">Empleado</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary w-100">Crear Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editarPerfilModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Perfil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="EditarPerfil">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" asp-for="PerfilInput.Nombre" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <input class="form-control" asp-for="PerfilInput.Correo" type="email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Área</label>
                        <select class="form-select" asp-for="PerfilInput.Area" required>
                            <option value="Administrativa">Administrativa</option>
                            <option value="Sistemas">Sistemas</option>
                            <option value="Recursos Humanos">Recursos Humanos</option>
                            <option value="Marketing">Marketing</option>
                            <option value="Contabilidad">Contabilidad</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select class="form-select" asp-for="PerfilInput.Rol" required>
                            <option value="Administrador">Administrador</option>
                            <option value="Empleado">Empleado</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary w-100">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
